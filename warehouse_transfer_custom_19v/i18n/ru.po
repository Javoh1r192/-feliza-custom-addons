#. module: warehouse_transfer_custom_19v
#: model_terms:ir.ui.view,arch_db:warehouse_transfer_custom_19v.view_picking_form_kamomat
msgid ""
"<b>Shortfall return.</b>\n"
"                    The shop received less than was sent and did not create a\n"
"                    backorder. Check the goods and validate to take them back\n"
"                    into stock."
msgstr ""
"<b>Возврат по недостаче.</b>\n"
"Магазин принял меньше, чем было отправлено, и не создал резервный\n"
"заказ. Проверьте товар и подтвердите документ, чтобы вернуть его\n"
"на склад."

