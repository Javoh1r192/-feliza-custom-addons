<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="pos_session_own_kassa_rule" model="ir.rule">
            <field name="name">Faqat o'z kassasi - Sessiya</field>
            <field name="model_id" ref="point_of_sale.model_pos_session"/>
            <field name="global" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[('config_id', 'in', user.allowed_pos_config_ids.ids)] if user.allowed_pos_config_ids else [(1, '=', 1)]</field>
        </record>

        <record id="pos_order_own_kassa_rule" model="ir.rule">
            <field name="name">Faqat o'z kassasi - Buyurtma</field>
            <field name="model_id" ref="point_of_sale.model_pos_order"/>
            <field name="global" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[('config_id', 'in', user.allowed_pos_config_ids.ids)] if user.allowed_pos_config_ids else [(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
