<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_feliza_salesperson_list" model="ir.ui.view">
        <field name="name">feliza.sale.salesperson.list</field>
        <field name="model">feliza.sale.salesperson</field>
        <field name="arch" type="xml">
            <list string="Sotuvchilar" editable="bottom">
                <field name="name"/>
                <field name="phone"/>
                <field name="order_count"/>
                <field name="total_amount"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_feliza_salesperson_form" model="ir.ui.view">
        <field name="name">feliza.sale.salesperson.form</field>
        <field name="model">feliza.sale.salesperson</field>
        <field name="arch" type="xml">
            <form string="Sotuvchi">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Sotuvchi ismi"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="phone"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="order_count"/>
                            <field name="total_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Izoh">
                        <field name="note" nolabel="1" placeholder="Qo'shimcha ma'lumot..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_feliza_salesperson_search" model="ir.ui.view">
        <field name="name">feliza.sale.salesperson.search</field>
        <field name="model">feliza.sale.salesperson</field>
        <field name="arch" type="xml">
            <search string="Sotuvchilar">
                <field name="name"/>
                <field name="phone"/>
                <filter name="f_inactive" string="Arxivlangan"
                        domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_feliza_salesperson" model="ir.actions.act_window">
        <field name="name">Sotuvchilar (Asosiy)</field>
        <field name="res_model">feliza.sale.salesperson</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_feliza_salesperson_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Birinchi sotuvchini qo'shing</p>
            <p>Bu ro'yxat POS sotuvchilaridan alohida — asosiy sotuv
               buyurtmalarida tanlanadi va KPI shu yerdan hisoblanadi.</p>
        </field>
    </record>

    <menuitem id="menu_feliza_salesperson"
              name="Sotuvchilar (Asosiy)"
              parent="sale.menu_sale_config"
              action="action_feliza_salesperson"
              sequence="50"/>
</odoo>
