<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Birka o'lchami 58 x 40 mm. Chekka (margin) NOL: birka printeri
             qog'ozning o'zini kesib beradi, qo'shimcha bo'sh joy qoldirsak
             yozuvlar siljib chiqadi. -->
        <record id="paperformat_feliza_label" model="report.paperformat">
            <field name="name">Feliza birka 58x40</field>
            <field name="default" eval="False"/>
            <field name="format">custom</field>
            <field name="page_width">58</field>
            <field name="page_height">40</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">96</field>
            <field name="disable_shrinking" eval="True"/>
        </record>

        <record id="action_report_feliza_label" model="ir.actions.report">
            <field name="name">Birka (58x40)</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">feliza_birka.report_feliza_label</field>
            <field name="report_file">feliza_birka.report_feliza_label</field>
            <field name="paperformat_id" ref="paperformat_feliza_label"/>
            <field name="print_report_name">'Birka - %s' % (object.name)</field>
            <field name="binding_model_id" eval="False"/>
        </record>

    </data>
</odoo>
