#. module: warehouse_transfer_custom_19v
#: model:ir.model.fields,field_description:warehouse_transfer_custom_19v.field_stock_move__real_source_warehouse_id
msgid "Haqiqiy yuboruvchi ombor"
msgstr "Фактический склад-отправитель"

#. module: warehouse_transfer_custom_19v
#: model:ir.model.fields,help:warehouse_transfer_custom_19v.field_stock_move__real_source_warehouse_id
msgid "Tranzit lokatsiyasidan (Inter Warehouse Transfer) qat'i nazar, yukning haqiqiy jo'natilgan ombori. Faqat omborlar aro o'tkazma harakatlari uchun to'ldiriladi."
msgstr "Фактический склад отправления груза, независимо от транзитной локации (Inter Warehouse Transfer). Заполняется только для межскладских перемещений."

#. module: warehouse_transfer_custom_19v
#: model:ir.model.fields,field_description:warehouse_transfer_custom_19v.field_stock_move__real_dest_warehouse_id
msgid "Haqiqiy qabul qiluvchi ombor"
msgstr "Фактический склад-получатель"

#. module: warehouse_transfer_custom_19v
#: model:ir.model.fields,help:warehouse_transfer_custom_19v.field_stock_move__real_dest_warehouse_id
msgid "Tranzit lokatsiyasidan (Inter Warehouse Transfer) qat'i nazar, yukning haqiqiy yetib borgan ombori. Faqat omborlar aro o'tkazma harakatlari uchun to'ldiriladi."
msgstr "Фактический склад назначения груза, независимо от транзитной локации (Inter Warehouse Transfer). Заполняется только для межскладских перемещений."

#. module: warehouse_transfer_custom_19v
#: model:ir.model.fields,field_description:warehouse_transfer_custom_19v.field_stock_move__interwh_report_status
msgid "Omborlar aro hisobot holati"
msgstr "Статус межскладского отчёта"

#. module: warehouse_transfer_custom_19v
#: model:ir.model.fields,help:warehouse_transfer_custom_19v.field_stock_move__interwh_report_status
msgid "Omborlar aro tarqatish hisobotida ushbu harakat ko'rsatilishi kerakmi va qanday holatda ko'rsatilishi kerakligini belgilaydi. Bo'sh bo'lsa - hisobotda ko'rinmaydi. Eslatma: 'Return' (qaytarish) harakatlari ataylab hisobotda alohida qator sifatida ko'rsatilmaydi - ular faqat bog'liq Delivery'ning 'Yo'lda' qoldig'ini kamaytirish uchun fonda hisobga olinadi (_interwh_resolved_qty orqali)."
msgstr "Определяет, должно ли данное перемещение отображаться в отчёте по межскладским перемещениям и в каком статусе. Если пусто — в отчёте не отображается. Примечание: операции 'Return' (возврат) намеренно не показываются отдельной строкой — они лишь уменьшают остаток 'В пути' связанной доставки в фоне (через _interwh_resolved_qty)."

#. module: warehouse_transfer_custom_19v
#: model:ir.model.fields,field_description:warehouse_transfer_custom_19v.field_stock_move__interwh_report_qty
msgid "Hisobot miqdori"
msgstr "Количество в отчёте"

#. module: warehouse_transfer_custom_19v
#: model:ir.model.fields,help:warehouse_transfer_custom_19v.field_stock_move__interwh_report_qty
msgid "Hisobotda ko'rsatiladigan miqdor. 'Yetib bordi' uchun - haqiqiy qabul qilingan miqdor. 'Yo'lda' uchun - hali hal qilinMAGAN qoldiq miqdor (qabul qilingan VA qaytarilgan miqdorlar ayrilgandan keyin)."
msgstr "Количество, отображаемое в отчёте. Для 'Доставлено' — фактически принятое количество. Для 'В пути' — ещё не урегулированный остаток (после вычета принятого И возвращённого количества)."

#. module: warehouse_transfer_custom_19v
#: model:ir.model.fields,field_description:warehouse_transfer_custom_19v.field_stock_move__interwh_report_dest_display
msgid "Qabul qiluvchi ombor (matn)"
msgstr "Склад-получатель (текст)"

#. module: warehouse_transfer_custom_19v
#: model:ir.model.fields,help:warehouse_transfer_custom_19v.field_stock_move__interwh_report_dest_display
