<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_feliza_picking_import_wizard" model="ir.ui.view">
        <field name="name">feliza.picking.import.wizard.form</field>
        <field name="model">feliza.picking.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Excel'dan tovar yuklash">
                <field name="state" invisible="1"/>

                <group invisible="state != 'choose'">
                    <field name="picking_id" readonly="1"
                           options="{'no_open': True}"/>
                    <field name="file" filename="filename" required="1"/>
                    <field name="filename" invisible="1"/>
                    <field name="mode" widget="radio"/>
                </group>
                <div class="alert alert-info" role="alert"
                     invisible="state != 'choose'">
                    Fayl <b>.xlsx</b> bo'lishi kerak. Ustunlar avtomat
                    tanib olinadi: <b>Баркод</b> (yoki Штрихкод / Barcode)
                    va <b>Отправлено</b> (yoki Количество / Qty).
                    Mos qidirish <b>barkod</b> bo'yicha bajariladi.
                </div>

                <div invisible="state != 'done'">
                    <field name="result_html" nolabel="1" readonly="1"/>
                    <group>
                        <field name="missing_file" filename="missing_name"
                               string="Topilmaganlar ro'yxati"
                               invisible="not missing_file" readonly="1"/>
                        <field name="missing_name" invisible="1"/>
                    </group>
                </div>

                <footer>
                    <button name="action_import" type="object" string="Yuklash"
                            class="btn-primary" invisible="state != 'choose'"/>
                    <button string="Bekor" class="btn-secondary"
                            special="cancel" invisible="state != 'choose'"/>
                    <button name="action_close" type="object" string="Yopish"
                            class="btn-primary" invisible="state != 'done'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_feliza_picking_import" model="ir.actions.act_window">
        <field name="name">Excel'dan tovar yuklash</field>
        <field name="res_model">feliza.picking.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">form</field>
    </record>

</odoo>
