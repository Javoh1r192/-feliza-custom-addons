<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.DebugMenu" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('o_debug_manager')]" position="attributes">
            <attribute name="t-if">!this.restricted</attribute>
        </xpath>
    </t>
    <t t-inherit="web.ExportAll" t-inherit-mode="extension" owl="1">
        <xpath expr="//DropdownItem" position="attributes">
            <attribute name="t-if">!this.restricted</attribute>
        </xpath>
    </t>
</templates>