<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_size_distribution_wizard_form" model="ir.ui.view">
        <field name="name">feliza.size.distribution.wizard.form</field>
        <field name="model">feliza.size.distribution.wizard</field>
        <field name="arch" type="xml">
            <form string="O'lchamlarga taqsimlash">
                <field name="picking_id" invisible="1"/>

                <div class="alert alert-info" role="status">
                    Har bir rang uchun kerakli o'lcham qatorlarini
                    "Qo'shish" orqali qo'shib, miqdorni kiriting. Miqdor
                    kiritgan rangning jami soni pastdagi "Talab" ustunidagi
                    songa teng bo'lishi shart.
                    <br/>
                    <b>O'lchamga bo'linmaydigan tovarni tashlab keting</b> —
                    unga hech narsa kiritmasangiz, o'sha qator hujjatda
                    borligicha qoladi.
                </div>

                <separator string="Ranglar bo'yicha holat"/>
                <field name="line_ids" nolabel="1" readonly="1">
                    <list create="0" delete="0" edit="0">
                        <field name="product_id" string="Rang"
                               options="{'no_open': True}"/>
                        <field name="demand_qty" string="Talab"/>
                        <field name="allocated_qty" string="Taqsimlandi"
                               decoration-success="allocated_qty == demand_qty"/>
                        <field name="remaining_qty" string="Qoldi"
                               decoration-warning="remaining_qty != 0"
                               decoration-success="remaining_qty == 0"/>
                    </list>
                </field>

                <separator string="O'lcham qatorlari"/>
                <field name="alloc_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="line_id" string="Rang"
                               domain="[('wizard_id', '=', parent.id)]"/>
                        <field name="size_value_id" string="O'lcham"/>
                        <field name="demand_qty" string="Talab" readonly="1"/>
                        <field name="quantity" string="Miqdor"/>
                        <field name="remaining_qty" string="Rang bo'yicha qoldi"
                               readonly="1"
                               decoration-success="remaining_qty == 0"
                               decoration-warning="remaining_qty != 0"/>
                    </list>
                </field>

                <footer>
                    <button name="action_apply" type="object"
                            string="Taqsimlash" class="btn-primary"/>
                    <button string="Bekor qilish" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
