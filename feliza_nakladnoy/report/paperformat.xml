<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Nakladnoy A4 da chop etiladi. Standart Odoo formatida chetlari
        keng (40 mm gacha) va jadval siqilib qoladi — shuning uchun
        o'z formatimiz: chetlar tor, jadvalga ko'proq joy.
    -->
    <record id="paperformat_nakladnoy" model="report.paperformat">
        <field name="name">Feliza nakladnoy (A4)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">13</field>
        <field name="margin_bottom">13</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">4</field>
        <field name="dpi">96</field>
    </record>
</odoo>
