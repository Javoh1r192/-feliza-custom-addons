<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         KAMOMAT — do'konga kam yetib borgan yuklar
         ============================================================ -->

    <record id="view_kamomat_move_list" model="ir.ui.view">
        <field name="name">stock.move.list.kamomat</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <list string="Shortfall" create="0" delete="0" edit="0"
                  default_order="date desc">
                <field name="date" string="Date"/>
                <field name="feliza_kamomat_delivery_id" string="Delivery"/>
                <field name="picking_id" string="Return document"/>
                <field name="feliza_kamomat_receipt_id" string="Shop receipt"
                       optional="show"/>
                <field name="location_dest_id" string="Back to"
                       optional="hide"/>
                <field name="feliza_kamomat_shop_id" string="Shop"/>
                <field name="product_id" string="Product"/>
                <field name="feliza_kamomat_qty" string="Shortfall"
                       sum="Total shortfall"/>
                <field name="quantity" string="Taken back"
                       sum="Total taken back" optional="hide"/>
                <field name="state" string="Status" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state not in ('done','cancel')"
                       decoration-muted="state == 'cancel'"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_kamomat_move_pivot" model="ir.ui.view">
        <field name="name">stock.move.pivot.kamomat</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <pivot string="Shortfall" sample="1">
                <field name="feliza_kamomat_shop_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="feliza_kamomat_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_kamomat_move_graph" model="ir.ui.view">
        <field name="name">stock.move.graph.kamomat</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <graph string="Shortfall" type="bar" sample="1">
                <field name="feliza_kamomat_shop_id"/>
                <field name="feliza_kamomat_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_kamomat_move_search" model="ir.ui.view">
        <field name="name">stock.move.search.kamomat</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <search string="Shortfall">
                <field name="product_id"/>
                <field name="picking_id" string="Return document"/>
                <field name="feliza_kamomat_delivery_id" string="Delivery"/>
                <field name="feliza_kamomat_shop_id" string="Shop"/>
                <filter name="f_kutilmoqda" string="Not taken back yet"
                        domain="[('state','not in',('done','cancel'))]"/>
                <filter name="f_qaytarilgan" string="Taken back"
                        domain="[('state','=','done')]"/>
                <separator/>
                <filter name="f_sana" string="Date" date="date"/>
                <group>
                    <filter name="g_dokon" string="Shop" domain="[]"
                            context="{'group_by': 'feliza_kamomat_shop_id'}"/>
                    <filter name="g_hujjat" string="Delivery" domain="[]"
                            context="{'group_by': 'feliza_kamomat_delivery_id'}"/>
                    <filter name="g_tovar" string="Product" domain="[]"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="g_holat" string="Status" domain="[]"
                            context="{'group_by': 'state'}"/>
                    <filter name="g_oy" string="Month" domain="[]"
                            context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kamomat" model="ir.actions.act_window">
        <field name="name">Shortfall</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_kamomat_move_search"/>
        <field name="domain">[('feliza_kamomat', '=', True)]</field>
        <field name="context">{'search_default_g_dokon': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No shortfall yet</p>
            <p>When a shop receives less than was sent and does not create a
               backorder, the remaining goods appear here and a return
               document to the source warehouse is created automatically.</p>
        </field>
    </record>

    <record id="action_kamomat_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_kamomat_move_list"/>
        <field name="act_window_id" ref="action_kamomat"/>
    </record>
    <record id="action_kamomat_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_kamomat_move_pivot"/>
        <field name="act_window_id" ref="action_kamomat"/>
    </record>
    <record id="action_kamomat_view_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_kamomat_move_graph"/>
        <field name="act_window_id" ref="action_kamomat"/>
    </record>

    <!-- «Отчет» yonida -->
    <menuitem id="menu_kamomat"
              name="Shortfall"
              parent="stock.menu_stock_root"
              action="action_kamomat"
              groups="stock.group_stock_user"
              sequence="99"/>

    <!-- ============================================================
         QABUL HUJJATIDA KAMOMAT BELGISI
         ============================================================ -->

    <record id="view_picking_form_kamomat" model="ir.ui.view">
        <field name="name">stock.picking.form.kamomat</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <!-- DIQQAT: `invisible` shartida ishlatiladigan maydon
                     yashiriladigan blokning ICHIDA turmasligi kerak —
                     aks holda u umuman yuklanmaydi va banner hech
                     qachon ko'rinmaydi. -->
                <field name="feliza_kamomat" invisible="1"/>
                <div class="alert alert-warning m-0" role="alert"
                     invisible="not feliza_kamomat">
                    <b>Shortfall return.</b>
                    The shop received less than was sent and did not create a
                    backorder. Check the goods and validate to take them back
                    into stock.
                    <div class="mt-1 d-flex flex-wrap gap-3">
                        <div><span class="fw-bold">Shop:</span>
                            <field name="feliza_kamomat_shop_id" readonly="1"
                                   class="oe_inline"/></div>
                        <div><span class="fw-bold">Delivery:</span>
                            <field name="feliza_kamomat_delivery_id"
                                   readonly="1" class="oe_inline"/></div>
                        <div><span class="fw-bold">Shop receipt:</span>
                            <field name="feliza_kamomat_receipt_id"
                                   readonly="1" class="oe_inline"/></div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_picking_internal_search_kamomat" model="ir.ui.view">
        <field name="name">stock.picking.search.kamomat</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <filter name="backorder" position="after">
                <filter name="f_kamomat" string="Shortfall returns"
                        domain="[('feliza_kamomat','=',True)]"/>
            </filter>
        </field>
    </record>

    <!-- ============================================================
         OMBOR KARTOCHKASIDA SONI (Inventory Overview)
         ============================================================ -->

    <record id="view_picking_type_kanban_kamomat" model="ir.ui.view">
        <field name="name">stock.picking.type.kanban.kamomat</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.stock_picking_type_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='picking_type_backorder_count']"
                   position="after">
                <div t-if="record.feliza_kamomat_count.raw_value > 0"
                     class="row" name="picking_type_kamomat_count">
                    <a class="col-8 offset-4 pe-0 text-truncate text-danger"
                       name="feliza_action_kamomat_pickings" type="object">
                        <div class="row">
                            <span class="col-6">Shortfall</span>
                            <field class="col-2 text-end"
                                   name="feliza_kamomat_count"/>
                        </div>
                    </a>
                </div>
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         KERAKSIZ MENYU (modulning o'ziniki)
         ============================================================ -->

    <record id="menu_stock_move_interwh_report" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

</odoo>
