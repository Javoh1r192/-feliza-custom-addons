<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Account Journal Form View - Analitik hisob qo'shish -->
        <record id="view_account_journal_form_inherit_analytic" model="ir.ui.view">
            <field name="name">account.journal.form.inherit.analytic</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <!-- Jurnal formiga yangi field qo'shish -->
                <xpath expr="//notebook" position="inside">
                    <page string="Analytic Distribution" groups="analytic.group_analytic_accounting">
                        <group>
                            <group>
                                <field name="default_analytic_distribution" 
                                       widget="analytic_distribution"
                                       options="{'product_field': False, 'business_domain': 'general'}"/>
                            </group>
                            <group>
                                <p class="text-muted">
                                    Bu jurnalda yaratilgan barcha yangi operatsiyalarga avtomatik ravishda qo'llaniladi.
                                </p>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
