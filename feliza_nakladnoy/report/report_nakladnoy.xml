<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ==================================================================
     FELIZA NAKLADNOY
     ==================================================================
     Uchta qism:
        1. Sarlavha  — hujjat turi, raqami, holati
        2. Pasport   — kim, qayerdan, qayerga, nechta, qancha
        3. Jadval    — nomi | artikul | rang | o'lcham | talab | soni | narx | summa
        4. Imzolar   — topshirdi / qabul qildi

     Ranglar qog'ozga chop etishga moslangan: matn qora, faqat ingichka
     chiziqlar va bitta ochiq fon ishlatiladi — kartrij tejaladi.
     ================================================================== -->

<template id="report_nakladnoy_document">
  <t t-set="c" t-value="doc.company_currency_id"/>
  <div class="page" style="font-family: Arial, 'Helvetica Neue', sans-serif; color:#1a1a1a; font-size:10pt;">

    <style>
      .fz-hdr{display:flex;justify-content:space-between;align-items:flex-end;
              border-bottom:2.5px solid #1a1a1a;padding-bottom:8px;margin-bottom:14px}
      .fz-brand{font-family:Georgia,'Times New Roman',serif;font-size:24pt;
                color:#a8785f;line-height:1;letter-spacing:.5px}
      .fz-brand small{display:block;font-family:Arial,sans-serif;font-size:7.5pt;
                letter-spacing:2.4px;color:#6b6b6b;margin-top:3px;text-transform:uppercase}
      .fz-title{text-align:right;line-height:1.15}
      .fz-title .t{font-size:15pt;font-weight:bold;letter-spacing:2px}
      .fz-title .n{font-size:19pt;font-weight:bold;font-family:'Courier New',monospace}
      .fz-pill{display:inline-block;border:1.2px solid #1a1a1a;border-radius:9px;
               padding:1px 9px;font-size:8pt;letter-spacing:.8px;margin-top:3px}
      .fz-pill.done{background:#1a1a1a;color:#fff}

      .fz-pass{width:100%;border-collapse:collapse;margin-bottom:12px}
      .fz-pass td{border:.6px solid #d5cec9;padding:5px 8px;vertical-align:top;width:25%}
      .fz-pass .lb{display:block;font-size:7pt;letter-spacing:1.1px;color:#7a7168;
                   text-transform:uppercase;margin-bottom:1px}
      .fz-pass .vl{font-size:10pt;font-weight:bold}

      .fz-sum{width:100%;border-collapse:collapse;margin-bottom:14px}
      .fz-sum td{border:.6px solid #1a1a1a;padding:6px 8px;width:25%;background:#f7f4f2}
      .fz-sum .lb{display:block;font-size:7pt;letter-spacing:1.1px;color:#6b6b6b;
                  text-transform:uppercase}
      .fz-sum .vl{font-size:14pt;font-weight:bold;font-family:'Courier New',monospace}

      table.fz-tbl{width:100%;border-collapse:collapse;font-size:9.5pt}
      table.fz-tbl thead th{background:#efe9e5;border:.6px solid #b9ada4;
              padding:6px 6px;font-size:8pt;letter-spacing:.6px;text-transform:uppercase;
              text-align:left}
      /* Jadval sarlavhasi HAR SAHIFADA takrorlansin, «JAMI» qatori esa
         faqat oxirida chiqsin — 9 sahifali hujjatda bu shart. */
      table.fz-tbl thead{display:table-header-group}
      table.fz-tbl tfoot{display:table-row-group}
      table.fz-tbl thead th.num{text-align:right}
      table.fz-tbl thead th.ctr{text-align:center}
      table.fz-tbl tbody tr{page-break-inside:avoid}
      table.fz-tbl td{border:.6px solid #d5cec9;padding:5px 6px;vertical-align:top}
      table.fz-tbl tbody tr:nth-child(even) td{background:#faf8f7}
      .num{text-align:right;font-family:'Courier New',monospace;white-space:nowrap}
      .ctr{text-align:center}
      .art{font-family:'Courier New',monospace;font-weight:bold}
      .joy{font-size:9pt;color:#4a4a4a}
      .kam{color:#9c3a2b;font-weight:bold}
      table.fz-tbl tfoot td{border:.6px solid #1a1a1a;background:#efe9e5;
              padding:6px;font-weight:bold;font-size:10pt}

      .fz-imzo{width:100%;border-collapse:collapse;margin-top:26px}
      .fz-imzo td{width:50%;padding:0 14px;vertical-align:top}
      .fz-imzo .ln{border-bottom:.8px solid #1a1a1a;height:26px}
      .fz-imzo .cap{font-size:7.5pt;letter-spacing:1px;color:#6b6b6b;
                    text-transform:uppercase;padding-top:3px}
    </style>

    <!-- ============ 1. SARLAVHA ============ -->
    <div class="fz-hdr">
      <div class="fz-brand">
        feliza
        <small t-out="doc.company_id.name or ''"/>
      </div>
      <div class="fz-title">
        <div class="t" t-out="doc.feliza_sarlavha"/>
        <div class="n" t-out="doc.name"/>
        <span class="fz-pill" t-attf-class="fz-pill #{'done' if doc.state == 'done' else ''}">
          <t t-if="doc.state == 'done'">YAKUNLANGAN</t>
          <t t-elif="doc.state == 'cancel'">BEKOR QILINGAN</t>
          <t t-elif="doc.state == 'assigned'">TAYYOR</t>
          <t t-else="">JARAYONDA</t>
        </span>
      </div>
    </div>

    <!-- ============ 2. PASPORT ============ -->
    <table class="fz-pass">
      <tr>
        <td>
          <span class="lb">Qayerdan</span>
          <span class="vl" t-out="doc.feliza_qayerdan or '—'"/>
        </td>
        <td>
          <span class="lb">Qayerga</span>
          <span class="vl" t-out="doc.feliza_qayerga or '—'"/>
        </td>
        <td>
          <span class="lb">Asos hujjat</span>
          <span class="vl" t-out="doc.origin or '—'"/>
        </td>
        <td>
          <span class="lb">Operatsiya turi</span>
          <span class="vl" t-out="doc.picking_type_id.name or '—'"/>
        </td>
      </tr>
      <tr>
        <td>
          <span class="lb">Yaratdi</span>
          <span class="vl" t-out="doc.create_uid.name or '—'"/>
        </td>
        <td>
          <span class="lb">Qabul qildi</span>
          <span class="vl" t-out="doc.feliza_qabul_qildi or '—'"/>
        </td>
        <td>
          <span class="lb">Yaratilgan sana</span>
          <span class="vl" t-out="doc.create_date"
                t-options='{"widget": "datetime", "format": "dd.MM.yyyy HH:mm"}'/>
        </td>
        <td>
          <span class="lb">Rejalashtirilgan sana</span>
          <span class="vl" t-out="doc.scheduled_date"
                t-options='{"widget": "datetime", "format": "dd.MM.yyyy HH:mm"}'/>
        </td>
      </tr>
      <tr t-if="doc.partner_id">
        <td colspan="4">
          <span class="lb">Kontragent</span>
          <span class="vl" t-out="doc.partner_id.name"/>
        </td>
      </tr>
    </table>

    <!-- ============ 3. XULOSA RAQAMLAR ============ -->
    <table class="fz-sum">
      <tr>
        <td>
          <span class="lb">Tovar turi</span>
          <span class="vl" t-out="doc.feliza_tur_soni"/>
        </td>
        <td>
          <span class="lb">
            <t t-if="doc.state == 'done'">Qabul qilindi (dona)</t>
            <t t-else="">Jami dona</t>
          </span>
          <span class="vl" t-out="doc.feliza_soni_matn"/>
        </td>
        <td>
          <span class="lb">Holat</span>
          <span class="vl" style="font-size:11pt">
            <t t-if="doc.state == 'done'">Yakunlangan</t>
            <t t-elif="doc.state == 'cancel'">Bekor qilingan</t>
            <t t-elif="doc.state == 'assigned'">Tayyor</t>
            <t t-else="">Jarayonda</t>
          </span>
        </td>
        <td>
          <span class="lb">Jami summa, so'm</span>
          <span class="vl" t-out="doc.feliza_summa_matn"/>
        </td>
      </tr>
    </table>

    <!-- ============ 4. JADVAL ============ -->
    <table class="fz-tbl">
      <thead>
        <tr>
          <th style="width:26px" class="ctr">№</th>
          <th>Tovar nomi</th>
          <th style="width:66px">Artikul</th>
          <th style="width:78px">Rang</th>
          <th style="width:58px">O'lcham</th>
          <th style="width:96px">Joylashuv</th>
          <th style="width:52px" class="num">Soni</th>
          <th style="width:74px" class="num">Narx, so'm</th>
          <th style="width:88px" class="num">Summa, so'm</th>
        </tr>
      </thead>
      <tbody>
        <t t-set="i" t-value="0"/>
        <tr t-foreach="doc.move_ids" t-as="move">
          <t t-set="i" t-value="i + 1"/>
          <td class="ctr" t-out="i"/>
          <td t-out="move.feliza_nomi"/>
          <td class="art" t-out="move.feliza_artikul or '—'"/>
          <td t-out="move.feliza_rang or '—'"/>
          <td t-out="move.feliza_olcham or '—'"/>
          <td class="joy" t-out="move.feliza_joy"/>
          <td t-attf-class="num #{'kam' if doc.state == 'done' and move.feliza_soni &lt; move.product_uom_qty else ''}"
              t-out="move.feliza_soni_matn"/>
          <td class="num" t-out="move.feliza_narx_matn"/>
          <td class="num" t-out="move.feliza_summa_matn"/>
        </tr>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="6" style="text-align:right">JAMI</td>
          <td class="num" t-out="doc.feliza_soni_matn"/>
          <td/>
          <td class="num" t-out="doc.feliza_summa_matn"/>
        </tr>
      </tfoot>
    </table>

    <!-- ============ 5. IZOH VA IMZOLAR ============ -->
    <div t-if="doc.note" style="margin-top:10px;font-size:9pt">
      <span style="font-size:7pt;letter-spacing:1.1px;color:#7a7168;text-transform:uppercase">Izoh</span><br/>
      <span t-out="doc.note"/>
    </div>

    <table class="fz-imzo">
      <tr>
        <td>
          <div class="ln"/>
          <div class="cap">Topshirdi — F.I.Sh. va imzo</div>
        </td>
        <td>
          <div class="ln"/>
          <div class="cap">Qabul qildi — F.I.Sh. va imzo</div>
        </td>
      </tr>
    </table>

  </div>
</template>

<template id="report_nakladnoy">
  <t t-call="web.html_container">
    <!--
        Takrorlanuvchi pastki qator: har sahifada sahifa raqami turadi.
        Hujjat 9 sahifa bo'lishi mumkin — omborchi varaqlarni
        aralashtirib yubormasligi uchun raqam shart.
        Matn UMUMIY — bir necha hujjat birga chop etilsa ham noto'g'ri
        raqam chiqmaydi.
    -->
    <div class="footer">
      <div style="font-family:Arial,sans-serif;font-size:7.5pt;color:#8a8078;
                  border-top:.6px solid #d5cec9;padding-top:4px;">
        <span>Feliza · nakladnoy · <t t-out="context_timestamp(datetime.datetime.now()).strftime('%d.%m.%Y %H:%M')"/></span>
        <span style="float:right">Sahifa <span class="page"/> / <span class="topage"/></span>
      </div>
    </div>
    <t t-foreach="docs" t-as="doc">
      <div class="article" t-att-data-oe-model="doc and 'stock.picking'"
           t-att-data-oe-id="doc and doc.id">
        <t t-call="feliza_nakladnoy.report_nakladnoy_document"/>
      </div>
    </t>
  </t>
</template>

</odoo>
