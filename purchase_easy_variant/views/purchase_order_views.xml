<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_easy_variant" model="ir.ui.view">
        <field name="name">purchase.order.form.easy.variant</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="before">
                <div style="margin-bottom:8px;" invisible="state not in ('draft','sent')">
                    <button name="action_open_variant_wizard"
                            type="object"
                            string="➕ Tez qo'shish (variant tanlash bilan)"
                            class="btn btn-primary"/>
                </div>
            </xpath>

            <!-- RASM ustuni — «Количество» dan keyin.
                 Xaridchi yangi tovarni suratga olib, shu yerning o'zida
                 qo'yadi; rasm mahsulotning o'ziga yoziladi va darhol
                 katalogda ham, POS'da ham ko'rinadi. -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']"
                   position="after">
                <field name="product_image"
                       string="Rasm"
                       widget="image"
                       options="{'size': [50, 50], 'accepted_file_extensions': 'image/*'}"
                       optional="show"
                       readonly="display_type or not product_id"/>
            </xpath>
        </field>
    </record>
</odoo>