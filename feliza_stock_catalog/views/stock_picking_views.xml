<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_catalog_button" model="ir.ui.view">
        <field name="name">stock.picking.form.catalog.button</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Кнопка «Каталог» рядом с «Добавить товар», как в Продажах/Закупках.
                 context передаёт order_id (id документа) — он нужен фронтенду каталога. -->
            <xpath expr="//field[@name='move_ids']/list/control" position="inside">
                <button string="Каталог"
                        name="action_add_from_catalog"
                        type="object"
                        class="px-4 btn-link"
                        context="{'order_id': parent.id}"/>
            </xpath>
        </field>
    </record>

</odoo>
