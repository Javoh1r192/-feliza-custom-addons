<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_feliza_web" model="ir.ui.view">
        <field name="name">product.template.form.feliza.web</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='group_standard_price']" position="after">
                <group name="group_feliza_web">
                    <field name="x_publish_web"/>
                    <field name="x_name_ru"/>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
