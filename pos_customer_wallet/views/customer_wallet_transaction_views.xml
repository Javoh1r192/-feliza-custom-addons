<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_customer_wallet_transaction_list" model="ir.ui.view">
        <field name="name">customer.wallet.transaction.list</field>
        <field name="model">customer.wallet.transaction</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="create_date desc">
                <field name="create_date" string="Sana"/>
                <field name="partner_id"/>
                <field name="transaction_type"/>
                <field name="amount"/>
                <field name="balance_after"/>
                <field name="pos_order_id"/>
                <field name="account_move_id"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_customer_wallet_transaction_form" model="ir.ui.view">
        <field name="name">customer.wallet.transaction.form</field>
        <field name="model">customer.wallet.transaction</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="transaction_type"/>
                        <field name="amount"/>
                        <field name="balance_after"/>
                        <field name="pos_order_id"/>
                        <field name="account_move_id"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_customer_wallet_transaction_search" model="ir.ui.view">
        <field name="name">customer.wallet.transaction.search</field>
        <field name="model">customer.wallet.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="pos_order_id"/>
                <filter string="Cashback hisoblandi" name="filter_earned"
                        domain="[('transaction_type', '=', 'cashback_earned')]"/>
                <filter string="Cashback ishlatildi" name="filter_used"
                        domain="[('transaction_type', '=', 'cashback_used')]"/>
                <filter string="Qo'lda tuzatildi" name="filter_manual"
                        domain="[('transaction_type', 'in', ['manual_topup', 'manual_adjustment'])]"/>
                <group>
                    <filter string="Mijoz" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Turi" name="group_type" context="{'group_by': 'transaction_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_customer_wallet_transaction" model="ir.actions.act_window">
        <field name="name">Mijoz hamyoni harakatlari</field>
        <field name="res_model">customer.wallet.transaction</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
