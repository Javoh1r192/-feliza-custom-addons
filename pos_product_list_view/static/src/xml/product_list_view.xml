<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pos_product_list_view.ProductScreen"
       t-inherit="point_of_sale.ProductScreen"
       t-inherit-mode="extension">

        <!-- Toggle tugmalarni CategorySelector dan keyin qo'shish -->
        <xpath expr="//CategorySelector" position="after">
            <div t-if="!pos.scanning"
                 class="product-view-toggle d-flex justify-content-end align-items-center px-2 py-1 bg-view border-bottom">
                <button
                    class="btn btn-sm view-toggle-btn me-1"
                    t-att-class="{ 'active': !isListView }"
                    t-on-click="() => this.setViewMode('grid')"
                    title="Card ko'rinishi">
                    <i class="fa fa-th-large"/>
                </button>
                <button
                    class="btn btn-sm view-toggle-btn"
                    t-att-class="{ 'active': isListView }"
                    t-on-click="() => this.setViewMode('list')"
                    title="List ko'rinishi">
                    <i class="fa fa-list"/>
                </button>
            </div>
        </xpath>

        <!-- product-list container klassini dinamik qilish -->
        <xpath expr="//div[hasclass('product-list')]" position="attributes">
            <attribute name="class">product-list px-2 pt-0 pb-2</attribute>
            <attribute name="t-att-class">isListView ? 'd-flex flex-column gap-1' : 'd-grid gap-1 gap-lg-2'</attribute>
        </xpath>

        <!-- ProductCard klass propini o'zgartirish -->
        <xpath expr="//ProductCard[@class='pos.productViewMode']" position="attributes">
            <attribute name="class">productCardClass</attribute>
        </xpath>

    </t>
    <!-- Nom davomida artikul, nom tagida shtrix-kod -->
    <t t-name="pos_product_list_view.ProductCardExtra"
       t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-name')]" position="after">
            <span t-if="props.product and props.product.default_code"
                  class="pos-pl-artikul" t-esc="props.product.default_code"/>
            <span class="pos-pl-price" t-esc="priceStr"/>
            <span t-att-class="'pos-pl-total ' + (storeQty &lt;= 0 ? 'pos-pl-zero' : 'pos-pl-ok')"
                  t-esc="storeQty"/>
            <div t-if="props.product and props.product.barcode"
                 class="pos-pl-barcode" t-esc="props.product.barcode"/>
        </xpath>
    </t>
</templates>
