<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_customer_wallet_adjustment_wizard_form" model="ir.ui.view">
        <field name="name">customer.wallet.adjustment.wizard.form</field>
        <field name="model">customer.wallet.adjustment.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="partner_id" readonly="1"/>
                    <field name="current_balance"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="amount"/>
                    <field name="note" placeholder="Masalan: kassadagi xatoni tuzatish"/>
                </group>
                <footer>
                    <button string="Tasdiqlash" type="object" name="action_apply" class="btn-primary"/>
                    <button string="Bekor qilish" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_customer_wallet_adjustment_wizard" model="ir.actions.act_window">
        <field name="name">Hamyon balansini tuzatish</field>
        <field name="res_model">customer.wallet.adjustment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
